{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": ["--no-install", "agentyx", "doctor", "--hook"],
            "statusMessage": "agentyx:session-doctor-bootstrap"
          }
        ]
      }
    ]
  }
}
