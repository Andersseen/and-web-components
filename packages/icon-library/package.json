{
  "name": "@andersseen/icon",
  "version": "0.2.0",
  "description": "Shared icon library for Andersseen web components",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "and-icons": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./icons.css": "./dist/icons.css",
    "./base.css": "./dist/base.css",
    "./icons/*.css": "./dist/icons/*.css",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./generate-css": {
      "types": "./dist/generate-css.d.ts",
      "import": "./dist/generate-css.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/lazy.js"
    }
  },
  "sideEffects": [
    "*.css",
    "./dist/browser.js"
  ],
  "files": [
    "dist",
    "dist-cjs",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist dist-cjs && tsc && node ../../scripts/fix-esm-extensions.cjs dist && tsc -p tsconfig.cjs.json && node scripts/build-icons-css.mjs && chmod +x dist/cli.js",
    "clean": "rm -rf dist dist-cjs",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "test -d dist || pnpm run build"
  },
  "keywords": [
    "icons",
    "svg",
    "web-components"
  ],
  "author": "Andersseen",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "eslint": "^10.1.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Andersseen/and-web-components.git",
    "directory": "packages/icon-library"
  }
}
